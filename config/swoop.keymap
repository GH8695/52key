#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define HOTKEY  3
#define MSE     4

#define AS(keycode) &as LS(keycode) keycode

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <170>;
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp TAB>;
        };
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        modcp: mod_copy {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_COPY";
            #binding-cells = <0>;
            bindings = <&as LS(C) C>, <&kp C>;

            mods = <(LGUI | RGUI)>;
        };
    };

    macros {
        dpsn: dpsn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp U &kp B &kp SPACE &kp T &kp LPAR &kp RPAR &kp RET &kp D &kp E &kp B &kp U &kp G &kp DOT &kp P &kp R &kp I &kp N &kp T &kp SPACE &kp T &kp H &kp I &kp S &kp W &kp O &kp R &kp K &kp B &kp O &kp O &kp K &kp DOT &kp N &kp A &kp M &kp E &kp RET &kp E &kp N &kp D &kp SPACE &kp S &kp U &kp B>;
            label = "DPSN";
        };

        saf: saf {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp S &kp E &kp L &kp E &kp C &kp T &kp SPACE &kp STAR &kp SPACE &kp F &kp R &kp O &kp M &kp SPACE>;
            label = "SAF";
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_00 {
            timeout-ms = <50>;
            key-positions = <>;
            bindings = <&kp  LSHFT>;
        };

        combo_11 {
            timeout-ms = <40>;
            key-positions = <>;
            bindings = <&mo 2>;
        };

        combo_22 {
            timeout-ms = <50>;
            key-positions = <>;
            bindings = <&kp EXCL>;
        };

        combo_33 {
            timeout-ms = <50>;
            key-positions = <>;
            bindings = <&kp AT>;
        };

        combo_44 {
            timeout-ms = <50>;
            key-positions = <>;
            bindings = <&kp HASH>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp TAB         &kp Q  &kp W                 &kp E                  &kp R         &kp T     &kp Y         &kp U       &kp I      &kp O      &kp P     &kp ESC
&kp LEFT_SHIFT  &kp A  &kp S                 &kp D                  &kp F         &kp G     &kp H         &kp J       &kp K      &kp L      &kp SEMI  &kp BACKSPACE
&kp LCTRL       &kp Z  &kp X                 &kp C                  &kp V         &kp B     &kp N         &kp M       &kp COMMA  &kp DOT    &kp FSLH  &kp ENTER
                       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SPACE     &kp LALT  &kp LEFT_WIN  &kp SPACE   &kp LBKT   &kp RBKT
                       &kp INSERT            &mo 4                  &kp CAPSLOCK  &mo 2     &mo 1         &kp C_MENU  &mo 9      &kp RCTRL
            >;
        };

        number_layer {
            label = "NUMBER";
            bindings = <
&kp CAPSLOCK  &none  &kp N7  &kp N8  &kp N9     &kp NUMBER_0  &kp F10   &kp F7     &kp F8        &kp F9  &kp PRINTSCREEN  &kp GRAVE
&trans        &none  &kp N4  &kp N5  &kp N6     &kp MINUS     &kp F11   &kp F4     &kp F5        &kp F6  &kp SCROLLLOCK   &trans
&trans        &none  &kp N1  &kp N2  &kp N3     &kp EQUAL     &kp F12   &kp F1     &kp F2        &kp F3  &kp PAUSE_BREAK  &trans
                     &trans  &trans  &kp SPACE  &kp LALT      &kp LWIN  &kp SPACE  &trans        &trans
                     &trans  &trans  &trans     &to 0         &to 0     &kp LALT   &kp LEFT_ALT  &trans
            >;
        };

        symbol_layer {
            label = "SYMBOL";
            bindings = <
&trans  &to 4      &kp LS(HOME)      &kp LS(LC(UP))    &kp LS(END)        &to 5     &kp HOME       &kp PAGE_UP       &kp UP             &kp PAGE_DOWN  &none    &trans
&trans  &kp LC(A)  &kp LS(LC(LEFT))  &kp LS(LC(DOWN))  &kp LS(LC(RIGHT))  &to 6     &kp END        &kp LEFT          &kp DOWN           &kp RIGHT      &kp SQT  &trans
&trans  &kp LC(Z)  &kp LC(X)         &kp LC(C)         &kp LC(V)          &to 7     &kp INSERT     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp DEL  &trans
                   &trans            &trans            &kp SPACE          &kp RALT  &kp RIGHT_GUI  &kp SPACE         &trans             &trans
                   &trans            &trans            &to 1              &to 0     &trans         &trans            &trans             &trans
            >;
        };

        layer_8 {
            bindings = <
&to 0   &trans  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &kp PG_UP  &kp HOME  &kp UP    &kp END    &trans             &trans
&trans  &trans  &saf             &dpsn            &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(LC(MINUS))  &trans
&trans  &trans  &trans           &trans           &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &trans     &trans    &trans    &trans     &trans             &trans
                &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &trans           &trans           &trans     &trans    &trans    &trans
                &trans           &trans           &trans           &trans           &to 0      &trans    &trans    &mo 3
            >;
        };

        layer_4 {
            bindings = <
&kp ESC    &kp NUMBER_1  &kp Q         &kp W  &kp E         &kp R     &kp Y   &kp U      &kp UP     &kp O       &kp P      &to 0
&kp TAB    &kp LSHIFT    &kp A         &kp S  &kp D         &kp F     &kp H   &kp LEFT   &kp DOWN   &kp RIGHT   &kp L      &none
&kp LCTRL  &kp NUMBER_2  &kp Z         &kp X  &kp C         &kp V     &kp N   &kp M      &kp COMMA  &kp PERIOD  &kp SLASH  &kp ENTER
                         &kp T         &kp B  &kp SPACE     &kp LALT  &trans  &kp SPACE  &trans     &trans
                         &kp NUMBER_4  &kp H  &kp NUMBER_3  &lt 9 G   &trans  &trans     &trans     &trans
            >;
        };

        layer_5 {
            bindings = <
&to 0   &trans  &trans          &mmv MOVE_UP    &trans           &to 0   &msc SCRL_UP    &msc SCRL_LEFT  &mkp MB3  &msc SCRL_RIGHT  &trans  &to 0
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &msc SCRL_DOWN  &mkp MB1        &mkp MB2  &kp C_MENU       &trans  &trans
&trans  &trans  &kp K_CUT       &kp K_COPY      &kp K_PASTE      &trans  &trans          &trans          &trans    &trans           &trans  &trans
                &trans          &trans          &kp ENTER        &to 0   &none           &kp KP_ENTER    &trans    &trans
                &none           &none           &none            &to 0   &none           &none           &none     &none
            >;
        };

        layer_6 {
            bindings = <
&kp TAB    &none  &kp HOME  &kp UP_ARROW  &kp END    &kp K_CALC      &kp KP_PLUS   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_ASTERISK  &kp ESC
&trans     &none  &kp LEFT  &kp DOWN      &kp RIGHT  &to 0           &kp KP_MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_DIVIDE    &kp BACKSPACE
&kp LCTRL  &none  &none     &none         &none      &kp KP_NUMLOCK  &kp CARET     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT       &kp KP_ENTER
                  &trans    &trans        &to 0      &to 0           &none         &to 0            &kp LEFT         &kp RIGHT
                  &trans    &trans        &trans     &trans          &trans        &trans           &trans           &trans
            >;
        };

        layer_7 {
            bindings = <
&to 0   &trans  &trans  &trans  &trans      &trans      &trans      &trans      &kp C_VOLUME_UP    &trans      &trans  &kp C_MUTE
&trans  &trans  &trans  &trans  &trans      &trans      &trans      &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_NEXT  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans             &trans      &trans  &trans
                &trans  &trans  &kp C_PLAY  &kp C_STOP  &kp C_STOP  &kp C_PLAY  &trans             &trans
                &trans  &trans  &trans      &to 0       &to 0       &trans      &trans             &trans
            >;
        };

        hotkey_layer {
            label = "HOTKEY";
            bindings = <
&kp ESC  &bt BT_SEL 0  &none         &bt BT_PRV    &none         &bt BT_CLR    &bt BT_CLR    &kp F7        &kp F8        &kp F9        &bt BT_SEL 0  &bt BT_SEL 0
&kp ESC  &sys_reset    &bt BT_PRV    &bt BT_NXT    &bt BT_NXT    &out OUT_USB  &out OUT_USB  &kp F4        &kp F5        &kp F6        &sys_reset    &none
&kp ESC  &bootloader   &none         &none         &none         &out OUT_BLE  &out OUT_BLE  &kp F1        &kp F2        &kp F3        &bootloader   &none
                       &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &bt BT_SEL 0  &to 0         &to 0         &none         &none
                       &bt BT_SEL 4  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 1  &kp NUMBER_3  &kp NUMBER_3  &kp NUMBER_3  &kp NUMBER_3
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_10 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
